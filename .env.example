# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# Database Connection (PostgreSQL connection string on Render/Cloud SQL)
DATABASE_URL=

# Security & Authentication (JWT Secret token)
JWT_SECRET=

# Server & Cross-Origin Resource Sharing (CORS)
FRONTEND_URL=
PORT=

# Brevo (formerly Sendinblue) Transactional Email API for Authentication OTP
BREVO_API_KEY=
BREVO_SENDER_EMAIL=concierge@aaru.luxury
BREVO_SENDER_NAME="AARU Atelier"
